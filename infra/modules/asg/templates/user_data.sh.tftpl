#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y httpd php php-mysqlnd php-cli jq unzip mariadb105

# Pull DB connection details from SSM Parameter Store (assignment-db-credentials)
# using this instance's IAM role - no credentials are ever hardcoded here.
SECRET_JSON=$(aws ssm get-parameter \
  --name "${secret_arn}" \
  --region "${aws_region}" \
  --with-decryption \
  --query Parameter.Value --output text)

DB_HOST=$(echo "$SECRET_JSON" | jq -r .host)
DB_USER=$(echo "$SECRET_JSON" | jq -r .username)
DB_PASS=$(echo "$SECRET_JSON" | jq -r .password)
DB_NAME=$(echo "$SECRET_JSON" | jq -r .dbname)

cat <<EOF > /etc/httpd/conf.d/assignment-env.conf
SetEnv DB_HOST "$DB_HOST"
SetEnv DB_USER "$DB_USER"
SetEnv DB_PASS "$DB_PASS"
SetEnv DB_NAME "$DB_NAME"
SetEnv S3_BUCKET "${artifact_bucket}"
SetEnv AWS_REGION "${aws_region}"
EOF

mkdir -p /var/www/html

# Self-healing deploy: every new/replaced instance (scale-out, instance
# refresh, terraform apply after a destroy, etc.) pulls whatever was last
# shipped by the deploy.yml workflow, so the fleet never drifts back to the
# placeholder page after the first real deploy. Falls back to a placeholder
# only before any deploy has ever run.
if aws s3api head-object --bucket "${artifact_bucket}" --key "${artifact_key}" --region "${aws_region}" >/dev/null 2>&1; then
  aws s3 cp "s3://${artifact_bucket}/${artifact_key}" /tmp/assignment-app.zip --region "${aws_region}"
  rm -rf /var/www/html/*
  unzip -o /tmp/assignment-app.zip -d /var/www/html
else
  echo "<?php http_response_code(200); echo 'assignment-event-ticketing: bootstrapped, waiting for first deploy.';" \
    > /var/www/html/index.php
  # Matches healthz.php's contract (no DB dependency) so the ALB target group
  # already sees this instance as healthy before the first real deploy.
  echo "<?php http_response_code(200); header('Content-Type: text/plain'); echo 'ok';" \
    > /var/www/html/healthz.php
fi

systemctl enable httpd
systemctl restart httpd

# One-time DB schema seed. Runs here (not via SSM Run Command from CI) because
# AWS Academy's LabRole generally can't register instances as SSM Managed
# Instances, so send-command targeting fails with InvalidInstanceId even
# though the agent's own outbound API calls (s3, ssm get-parameter, both used
# above) work fine. This reuses that same already-working path instead.
#
# Guarded by an S3 marker + a DB-side check so it's a safe no-op on every
# later launch (scale-out, instance refresh, etc.), and wrapped so a seeding
# failure can never take down httpd/healthz - db-init.yml confirms success by
# polling for the marker object rather than by this script's exit code.
(
  set +e
  SEED_MARKER_KEY="db-init/.seeded"
  SCHEMA_KEY="db-init/schema.sql"

  if ! aws s3api head-object --bucket "${artifact_bucket}" --key "$SEED_MARKER_KEY" --region "${aws_region}" >/dev/null 2>&1; then
    ALREADY_SEEDED=$(mysql -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASS" -N -e \
      "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$DB_NAME' AND table_name='users'" 2>/dev/null)
    ALREADY_SEEDED="$${ALREADY_SEEDED:-0}"

    if [ "$ALREADY_SEEDED" -eq 0 ] 2>/dev/null; then
      aws s3 cp "s3://${artifact_bucket}/$SCHEMA_KEY" /tmp/schema.sql --region "${aws_region}" \
        && mysql -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" < /tmp/schema.sql \
        && echo "Database seeded from $SCHEMA_KEY."

      S3_PREFIX="https://${artifact_bucket}.s3.${aws_region}.amazonaws.com/uploads/"
      mysql -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASS" -D "$DB_NAME" -e \
        "UPDATE events SET image_url = REPLACE(image_url, '/uploads/', '$S3_PREFIX') WHERE image_url LIKE '/uploads/%';"
    fi

    # Only mark done once we've confirmed the table actually exists now -
    # covers both "we just seeded it" and "it turns out it already existed".
    STILL_CHECK=$(mysql -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASS" -N -e \
      "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$DB_NAME' AND table_name='users'" 2>/dev/null)
    if [ "$${STILL_CHECK:-0}" -gt 0 ] 2>/dev/null; then
      aws s3api put-object --bucket "${artifact_bucket}" --key "$SEED_MARKER_KEY" --region "${aws_region}" >/dev/null 2>&1
    else
      echo "DB seed check failed - not writing marker, db-init.yml will time out and this will retry on the next relaunch." >&2
    fi
  fi
) || true
